# Copy to .env on your own computer or host. Leave values empty until you set them.
# No real passwords or API keys are included in this project.

VITE_AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Amazon Associates tracking ID for Juniper.
# Only the approved ID "juniperfinds6-20" is accepted.
# Unset or empty uses the approved ID.
# Any other value (including other correctly formatted IDs) is rejected;
# the system never silently substitutes a different affiliate ID.
# Affiliate link construction fails closed (returns no link) on rejection.
VITE_OWNER_AFFILIATE_TAG=juniperfinds6-20
