# Copy to .env on your own computer or host. Leave values empty until you set them.
# No real passwords or API keys are included in this project.

VITE_AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Amazon Associates tracking ID for Juniper.
# Configurable via Netlify (or other host) environment variables.
# Code defaults to "juniperfinds6-20" when unset or empty.
# Invalid values (wrong format) cause affiliate link construction to fail closed (no outbound link).
# Do not reuse any other account's tracking ID.
VITE_OWNER_AFFILIATE_TAG=juniperfinds6-20
